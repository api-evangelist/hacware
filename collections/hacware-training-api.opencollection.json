        {
          "info": {
            "name": "Enroll User to Course",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{domain}/api/v1/train/add_course_member/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Adds a user to a specified course. Blank date will send the course instantly."
        },
        {
          "info": {
            "name": "Get Course List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{domain}/api/v1/train/courselist/",
            "params": [
              {
                "name": "course_type",
                "value": "",
                "type": "query",
                "description": "Course Type. (Optional)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Return a list of all the courses or a specific courses in the account."
        },
