                "description": "Training ID (Required)"
              },
              {
                "name": "VideoID",
                "value": "",
                "type": "query",
                "description": "Video ID (Required)"
              },
              {
                "name": "trainAction",
                "value": "",
                "type": "query",
                "description": "Type of Training (Required)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets the training status of a quiz that was sent out."
        },
